# ~/suno-analysis/.env on the VPS (chmod 600). Read by deploy/docker-compose.prod.yml.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me

# ── Qdrant (container, localhost only) ───────────────────────────────────────
QDRANT_COLLECTION=discord_openai
QDRANT_API_KEY=change-me

# ── Application ──────────────────────────────────────────────────────────────
# demo / single: no login (auto-login) · multi: user accounts required
APP_MODE=demo
OPENAI_API_KEY=
RUST_LOG=info

# ── AI service ───────────────────────────────────────────────────────────────
# When set, emotion inference is forwarded to this Hugging Face endpoint instead
# of running the local ONNX model.
HF_ENDPOINT_URL=

# ── Images (IMAGE_TAG is written by CI on each deploy) ───────────────────────
# BACKEND_IMAGE=ghcr.io/hafizhrafizal/suno-discord-analysis-backend
# AI_IMAGE=ghcr.io/hafizhrafizal/suno-discord-analysis-ai
# IMAGE_TAG=latest
