# Multi-stage build for local development — compiles Rust inside Docker.
# Production uses the plain Dockerfile (binary pre-built by CI).
FROM rust:1-bookworm AS builder
ENV CARGO_TARGET_DIR=/app/target
WORKDIR /app
COPY backend/ .
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/retrieval-backend ./retrieval-backend
EXPOSE 8000
CMD ["./retrieval-backend"]
